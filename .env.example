# cp .env.example .env  puis compléter — .env ne doit jamais être versionné.

# ── Base de données ────────────────────────────────────────────────
POSTGRES_USER=pmu
POSTGRES_DB=pmu
# Obligatoire, sans valeur par défaut : générer avec `openssl rand -base64 24`
POSTGRES_PASSWORD=

# ── Réseau ─────────────────────────────────────────────────────────
API_PORT=8100
TZ=Europe/Paris

# ── Broker MQTT (celui de zigbee2mqtt) ─────────────────────────────
# Laisser MQTT_HOST vide pour désactiver la publication vers Home Assistant.
MQTT_HOST=192.168.1.153
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_DISCOVERY_PREFIX=homeassistant

# ── Comportement ───────────────────────────────────────────────────
# Requêtes/seconde vers l'API PMU. Ne pas monter : elle n'est pas publique
# et rien n'oblige le PMU à tolérer un client trop gourmand.
PMU_RPS=2
# Période de relevé des cotes, en secondes.
PMU_PERIODE_COTES=300
# Fenêtre avant le départ pendant laquelle on relève, en minutes.
PMU_FENETRE_COTES=45
# Modèle publié vers HA : sans_marche (recommandé) ou avec_marche.
PMU_MODELE=sans_marche
